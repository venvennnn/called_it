# Demo works without Twitch credentials. Keep demo and live databases separate.
APP_MODE=demo
APP_ORIGIN=http://localhost:5173
PORT=3001
DATABASE_PATH=.data/demo.sqlite
LOG_LEVEL=info
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# For a deliberately PUBLIC, disposable production demo only:
ALLOW_PUBLIC_DEMO=false
